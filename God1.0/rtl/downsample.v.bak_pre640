//======================================================================
// Module: downsample
// Function: 流式降采样 800×600 → 80×60
//   每 10 像素取 1, 每 10 行取 1
//   输出 80×60 = 4800 像素/帧
//
//   v3 (2026-08-01):
//     - 分辨率回到 80×60 (2M 双缓冲帧率优先)
//     - 网格判定改回"直接计算" (乘倒数代替 `/` 除法):
//       计数器推网格 (v2) 依赖 pix_y 每行都变, 若某行没按预期变化
//       网格就漂移 → 画面横向左移/撕裂. 直接算 pix_x/10、pix_y/10
//       与原始除法版等价, 对任意输入都稳定.
//     - 避开 HDL `/` (本机 cbx_lpm_divide.dll 打不开) 与 `*` 推断.
//
//   范围保护: 仅保留 pix_x<800 && pix_y<600 窗口内采样, 每帧 4800 个.
// Clock:  pclk 域
//======================================================================
module downsample (
    input  wire        pclk,
    input  wire        rst_n,
    input  wire [7:0]  y_data,        // Y 通道 (来自 ov5640_capture)
    input  wire        y_valid,       // Y 有效脉冲
    input  wire [9:0]  pix_x,         // 全分辨率列坐标 0-799
    input  wire [9:0]  pix_y,         // 全分辨率行坐标 0-599
    output reg  [7:0]  ds_y_data,     // 降采样后 Y 值
    output reg         ds_y_valid,    // 降采样有效脉冲
    output reg  [6:0]  ds_pix_x,      // 0-79 (当前未使用)
    output reg  [5:0]  ds_pix_y       // 0-59 (当前未使用)
);

    //------------------------------------------------------------------
    // 范围保护: 仅保留 800×600 窗口内的采样
    //------------------------------------------------------------------
    wire in_range = (pix_x < 10'd800) && (pix_y < 10'd600);

    //------------------------------------------------------------------
    // 直接计算网格坐标 (/10), 用乘倒数: x*6554 >> 16
    //   6554/65536 ≈ 0.1000061, 对 x≤1023 误差 < 0.007 < 最小余数 0.1, 精确.
    //   显式移位加法, 避开 HDL `/` 除法 (cbx_lpm_divide.dll 打不开)
    //------------------------------------------------------------------
    wire [23:0] x_p  = (pix_x << 12) + (pix_x << 11)
                     + (pix_x << 8)  + (pix_x << 7)
                     + (pix_x << 4)  + (pix_x << 3)
                     + (pix_x << 1);
    wire [23:0] y_p  = (pix_y << 12) + (pix_y << 11)
                     + (pix_y << 8)  + (pix_y << 7)
                     + (pix_y << 4)  + (pix_y << 3)
                     + (pix_y << 1);
    wire [9:0] x_div10 = x_p[23:16];
    wire [9:0] y_div10 = y_p[23:16];

    // 整除判断: x_div10*10 == pix_x  (x_div10*10 = (x<<3)+(x<<1))
    wire x_at_grid = ((x_div10 << 3) + (x_div10 << 1)) == pix_x;
    wire y_at_grid = ((y_div10 << 3) + (y_div10 << 1)) == pix_y;

    //------------------------------------------------------------------
    // 输出寄存
    //------------------------------------------------------------------
    always @(posedge pclk or negedge rst_n) begin
        if (!rst_n) begin
            ds_y_data  <= 8'd0;
            ds_y_valid <= 1'b0;
            ds_pix_x   <= 7'd0;
            ds_pix_y   <= 6'd0;
        end else begin
            ds_y_valid <= 1'b0;   // 默认低
            if (y_valid && x_at_grid && y_at_grid && in_range) begin
                ds_y_data  <= y_data;
                ds_y_valid <= 1'b1;
                ds_pix_x   <= x_div10[6:0];   // 0-79
                ds_pix_y   <= y_div10[5:0];   // 0-59
            end
        end
    end

endmodule
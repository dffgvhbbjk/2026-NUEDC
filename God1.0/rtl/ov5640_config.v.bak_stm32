        config_rom[71] = {16'h5807, 8'h08};
        config_rom[72] = {16'h5808, 8'h05};
        config_rom[73] = {16'h5809, 8'h05};
        config_rom[74] = {16'h580A, 8'h08};
        config_rom[75] = {16'h580B, 8'h0D};
        config_rom[76] = {16'h580C, 8'h08};
        config_rom[77] = {16'h580D, 8'h03};
        config_rom[78] = {16'h580E, 8'h00};

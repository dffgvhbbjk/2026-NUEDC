//======================================================================
// Module: ov5640_config
// Function: SCCB 协议配置 OV5640 寄存器
//   上电后依次写入寄存器配置表, 完成后拉高 config_done
//   SCCB 时钟 ~400kHz (50MHz / 125, 每半周期 125 个时钟)
//   OV5640 设备地址: 0x78 (写), 寄存器地址 16-bit (高字节 + 低字节)
//
// 协议 (写事务, 每个寄存器):
//   START → DEV_ADDR(0x78) + ACK → REG_HI + ACK → REG_LO + ACK
//         → DATA + ACK → STOP
//   每字节 8 数据位 + 1 ACK 位 = 9 位
//   总步数: 1(START) + 4×9(字节) + 1(STOP) = 38 步
//
// Clock:  50MHz 系统时钟
//======================================================================
module ov5640_config (
    input  wire        clk,           // 50MHz
    input  wire        rst_n,
    output reg         sclk,          // SCCB 时钟 (~400kHz)
    inout  wire        sdat,          // SCCB 数据 (开漏)
    output reg         config_done    // 配置完成
);

    //==================================================================
    // 寄存器配置表 (ROM)
    //   每项 24-bit: {reg_addr[15:0], reg_data[7:0]}
    //   SVGA 800x600 @ YUV422 8-bit DVP, XCLK=24MHz
    //   配置序列参考野火官方 OV5640 例程 (ov5640_cfg.v)
    //   补齐野火 rom[207] 0x3008=0x02 唤醒 standby 等关键寄存器
    //==================================================================

    localparam REG_NUM = 246;

    reg [23:0] config_rom [0:REG_NUM-1];

    // 完全照搬野火官方 bsp_ov5640.c: RGB565_Init + RGB565_WVGA (854×480@30)
    initial begin
        config_rom[0] = {16'h3103, 8'h03};
        config_rom[1] = {16'h3008, 8'h02};
        config_rom[2] = {16'h3017, 8'hFF};
        config_rom[3] = {16'h3018, 8'hFF};
        config_rom[4] = {16'h3034, 8'h1A};
        config_rom[5] = {16'h3037, 8'h13};
        config_rom[6] = {16'h3108, 8'h01};
        config_rom[7] = {16'h3630, 8'h36};
        config_rom[8] = {16'h3631, 8'h0E};
        config_rom[9] = {16'h3632, 8'hE2};
        config_rom[10] = {16'h3633, 8'h12};
        config_rom[11] = {16'h3621, 8'hE0};
        config_rom[12] = {16'h3704, 8'hA0};
        config_rom[13] = {16'h3703, 8'h5A};
        config_rom[14] = {16'h3715, 8'h78};
        config_rom[15] = {16'h3717, 8'h01};
        config_rom[16] = {16'h370B, 8'h60};
        config_rom[17] = {16'h3705, 8'h1A};
        config_rom[18] = {16'h3905, 8'h02};
        config_rom[19] = {16'h3906, 8'h10};
        config_rom[20] = {16'h3901, 8'h0A};
        config_rom[21] = {16'h3731, 8'h12};
        config_rom[22] = {16'h3600, 8'h08};
        config_rom[23] = {16'h3601, 8'h33};
        config_rom[24] = {16'h302D, 8'h60};
        config_rom[25] = {16'h3620, 8'h52};

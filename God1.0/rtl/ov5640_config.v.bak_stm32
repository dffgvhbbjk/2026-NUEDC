        config_rom[41] = {16'h3C09, 8'h1C};
        config_rom[42] = {16'h3C0A, 8'h9C};
        config_rom[43] = {16'h3C0B, 8'h40};
        config_rom[44] = {16'h3810, 8'h00};
        config_rom[45] = {16'h3811, 8'h10};

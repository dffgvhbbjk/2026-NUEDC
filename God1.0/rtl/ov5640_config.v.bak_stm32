        config_rom[50] = {16'h3000, 8'h00};
        config_rom[51] = {16'h3004, 8'hFF};
        config_rom[52] = {16'h300E, 8'h58};
        config_rom[53] = {16'h302E, 8'h00};
        config_rom[54] = {16'h4300, 8'h6F};
        config_rom[55] = {16'h501F, 8'h01};
        config_rom[56] = {16'h440E, 8'h00};
        config_rom[57] = {16'h5000, 8'hA7};
        config_rom[58] = {16'h3A0F, 8'h30};
        config_rom[59] = {16'h3A10, 8'h28};
        config_rom[60] = {16'h3A1B, 8'h30};
        config_rom[61] = {16'h3A1E, 8'h26};
        config_rom[62] = {16'h3A11, 8'h60};
        config_rom[63] = {16'h3A1F, 8'h14};

//======================================================================
// Module: downsample
// Function: 流式降采样 800×600 → 80×60
//   每 10 像素取 1, 每 10 行取 1
//   输出 80×60 = 4800 像素/帧
//   用常数除法判断 pix_x/pix_y 是否为 10 的倍数 (Quartus 优化为查表)
//
//   范围保护 (2026-07-28 花屏修复):
//   若 OV5640 实际输出分辨率高于 800×600 (例如 ISP 缩放未生效,
//   实测输出 ~1310×976, 每行 ~131 个降采样点), 超出 800×600 窗口
//   的采样一律丢弃, 保证每帧恰好 4800 个采样 (80/行 × 60行).
//   这样 uart_tx_2M 的顺序打包不会错位 (花屏), 写地址也不会
//   超过 8192 回卷覆盖. 此时预览画面为实际场景的左上角裁切.
//   根治方法仍是修正 ov5640_config 使 DVP 输出真正为 800×600.
// Clock:  pclk 域
//======================================================================
module downsample (
    input  wire        pclk,
    input  wire        rst_n,
    input  wire [7:0]  y_data,        // Y 通道 (来自 ov5640_capture)
    input  wire        y_valid,       // Y 有效脉冲
    input  wire [9:0]  pix_x,         // 全分辨率列坐标 0-799
    input  wire [9:0]  pix_y,         // 全分辨率行坐标 0-599
    output reg  [7:0]  ds_y_data,     // 降采样后 Y 值
    output reg         ds_y_valid,    // 降采样有效脉冲
    output reg  [6:0]  ds_pix_x,      // 0-79
    output reg  [5:0]  ds_pix_y       // 0-59
);

    //------------------------------------------------------------------
    // 计算 pix_x/10 和 pix_y/10, 并检查是否整除
    //   常数除法由 Quartus 综合为 LUT 查表, 资源开销小
    //   *10 为常数乘 (移位+加), 几乎不耗资源
    //------------------------------------------------------------------
    wire [9:0] x_div10 = pix_x / 10;
    wire [9:0] y_div10 = pix_y / 10;
    wire       x_at_grid = (x_div10 * 4'd10 == pix_x);
    wire       y_at_grid = (y_div10 * 4'd10 == pix_y);

    //------------------------------------------------------------------
    // 范围保护: 仅保留 800×600 窗口内的采样
    //   摄像头实际输出大于 800×600 时, 丢弃右侧/下侧多余采样,
    //   每帧严格输出 4800 个采样, 保证 UART 帧内图像不错位
    //------------------------------------------------------------------
    wire       in_range  = (pix_x < 10'd800) && (pix_y < 10'd600);

    //------------------------------------------------------------------
    // 输出寄存
    //------------------------------------------------------------------
    always @(posedge pclk or negedge rst_n) begin
        if (!rst_n) begin
            ds_y_data  <= 8'd0;
            ds_y_valid <= 1'b0;
            ds_pix_x   <= 7'd0;
            ds_pix_y   <= 6'd0;
        end else begin
            ds_y_valid <= 1'b0;
            if (y_valid && x_at_grid && y_at_grid && in_range) begin
                ds_y_data  <= y_data;
                ds_y_valid <= 1'b1;
                ds_pix_x   <= x_div10[6:0];   // 0-79
                ds_pix_y   <= y_div10[5:0];   // 0-59
            end
        end
    end

endmodule
